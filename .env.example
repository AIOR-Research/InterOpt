# Hosted API endpoint. Replace only in your private local .env file.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-private-key

# Model identifiers used in the reported local runs.
GENERIC_AGENT_MODEL=deepseek-v4-pro
USER_SIMULATOR_MODEL=deepseek-v4-pro
DETECTOR_MODEL=deepseek-v4-pro
READY_GATE_MODEL=deepseek-v4-pro
FORMULATION_QUESTION_SELECTOR_MODEL=deepseek-v4-pro
JUDGE_MODEL=deepseek-v4-pro

# Optional local output location. A relative path keeps the package portable.
AIOR_RUNS_ROOT=runs
